# sotcport: writes OUTPUT with a hash of the files listed in LIST (one per line): the sources
# that decide what the shader cache on disk holds (see shadps4/src/video_core/cache_storage.cpp).
# The header is only rewritten when the hash changes.
# Code between "sotcport: cache-neutral begin" and "sotcport: cache-neutral end" comments is
# left out: it decides when pipelines are built (for example on a background thread), not what
# the cache holds, so changing it keeps the cache the player has built up. Files without such
# blocks hash exactly as before.
file(STRINGS ${LIST} inputs)
set(hashes "")
foreach(input IN LISTS inputs)
    file(READ ${input} content)
    string(FIND "${content}" "sotcport: cache-neutral begin" first_neutral)
    if(first_neutral EQUAL -1)
        file(SHA1 ${input} hash) # exactly the hash of the file, as before neutral blocks existed
        string(APPEND hashes "${hash}")
        continue()
    endif()
    set(kept "")
    while(TRUE)
        string(FIND "${content}" "sotcport: cache-neutral begin" begin)
        if(begin EQUAL -1)
            string(APPEND kept "${content}")
            break()
        endif()
        # Whole lines go: from the start of the line with the begin marker to the end of the
        # line with the end marker, newline included, so the rest is the file as it was before.
        string(SUBSTRING "${content}" 0 ${begin} head)
        string(FIND "${head}" "\n" line_start REVERSE)
        math(EXPR line_start "${line_start} + 1")
        string(SUBSTRING "${head}" 0 ${line_start} head)
        string(APPEND kept "${head}")
        string(SUBSTRING "${content}" ${begin} -1 content)
        string(FIND "${content}" "sotcport: cache-neutral end" end)
        if(end EQUAL -1)
            message(FATAL_ERROR "${input}: cache-neutral block without an end")
        endif()
        string(SUBSTRING "${content}" ${end} -1 content)
        string(FIND "${content}" "\n" line_end)
        if(line_end EQUAL -1)
            set(content "")
        else()
            math(EXPR line_end "${line_end} + 1")
            string(SUBSTRING "${content}" ${line_end} -1 content)
        endif()
    endwhile()
    string(SHA1 hash "${kept}")
    string(APPEND hashes "${hash}")
endforeach()
string(SHA1 version "${hashes}")
string(SUBSTRING ${version} 0 16 version)
file(WRITE ${OUTPUT}.tmp
     "#pragma once\n// Generated by shader_cache_version.cmake.\n"
     "#define SOTC_SHADER_CACHE_VERSION \"${version}\"\n")
file(COPY_FILE ${OUTPUT}.tmp ${OUTPUT} ONLY_IF_DIFFERENT)
file(REMOVE ${OUTPUT}.tmp)
